# Lấy API key tại https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Tên model Gemma dùng qua Google Generative Language API
# (ví dụ: gemma-4-31b-it ...)
GEMMA_MODEL=gemma-4-31b-it

# Tên hiển thị của bot trong phòng chat
BOT_NAME=Gemma

# Địa chỉ và cổng chạy server
HOST=127.99.128.39
PORT=8888

# Khóa bí mật session của Flask (tuỳ chọn)
SECRET_KEY=change-me

# Giới hạn lưu trữ tin nhắn (lưu vào SQLite tại DB_PATH, không mất khi restart)
# Vượt ngưỡng này thì tin cũ nhất tự động bị xoá
MAX_HISTORY_MESSAGES=20000

# Giới hạn số ký tự tối đa cho mỗi tin nhắn
MAX_MESSAGE_LENGTH=2000

# Đường dẫn file database SQLite (mặc định: chat.db cùng thư mục app.py)
DB_PATH=chat.db

# Số tin nhắn gần nhất gửi cho client khi vừa vào phòng chat
HISTORY_LOAD_LIMIT=200

# Thời gian tối thiểu (giây) giữa 2 lần bot trả lời, tránh spam trả lời liên tục
BOT_REPLY_COOLDOWN_SECONDS=10

# Đường dẫn file chứa system instruction tuỳ chỉnh cho bot (nội dung sẽ được
# inject vào đầu system instruction gửi cho model mỗi lần gọi). Sửa nội dung
# instruction.txt để thay đổi tính cách / quy tắc trả lời của bot.
BOT_INSTRUCTION_FILE=instruction.txt

# Chế độ "giống người thật": true = bot tự trả lời mọi tin nhắn trong phòng
# (theo cooldown BOT_REPLY_COOLDOWN_SECONDS), không cần nhắc "@Tên bot".
# false (mặc định) = chỉ trả lời khi có ai đó nhắc tên bot trong tin nhắn.
HUMAN_LIKE_MODE=false

# Các tham số sinh nội dung của model (tương ứng generate_content_config)
BOT_TEMPERATURE=0.6
BOT_MAX_OUTPUT_TOKENS=300

# Mức độ "suy nghĩ" của model trước khi trả lời — để trống để tắt.
# Giá trị hợp lệ tuỳ theo model đang dùng (vd: MINIMAL, LOW, MEDIUM, HIGH).
# Lưu ý: không phải model Gemma nào cũng hỗ trợ thinking_config.
BOT_THINKING_LEVEL=

# Bật Google Search tool cho model (tương ứng tools=[GoogleSearch]).
# Lưu ý: không phải model Gemma nào cũng hỗ trợ tool này.
BOT_ENABLE_GOOGLE_SEARCH=false

# =========================================
# Cloudflare Tunnel (cloudflared)
# =========================================
# true = tự tải (nếu chưa có) và chạy cloudflared để public phòng chat ra internet.
TUNNEL=false

# Domain named tunnel (cấu hình sẵn trên Cloudflare Zero Trust dashboard, gắn
# với TUNNEL_TOKEN bên dưới). Chỉ có tác dụng khi TUNNEL_TOKEN cũng được đặt.
TUNNEL_HOST=chatweb.huskydg.io.vn

# Token của named tunnel, lấy từ Cloudflare Zero Trust > Networks > Tunnels.
# Lưu ý: TUNNEL=true mà thiếu TUNNEL_TOKEN hoặc TUNNEL_HOST thì sẽ bị bỏ qua
# cấu hình named tunnel, và app sẽ tự chuyển sang chế độ quick tunnel
# (domain tạm dạng *.trycloudflare.com).
TUNNEL_TOKEN=
